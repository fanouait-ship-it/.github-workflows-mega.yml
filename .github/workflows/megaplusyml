name: Transfert vers MEGA

on:
  workflow_dispatch:
    inputs:
      url:
        description: "Lien direct, magnet: ou URL d'un .torrent"
        required: true
      lister:
        description: "Lister seulement les fichiers du torrent (sans rien télécharger)"
        type: boolean
        default: false
      fichiers:
        description: "Numéros des fichiers à télécharger (ex: 5 ou 1,3 ou 2-4). Vide = tout"
        required: false
        default: ""
      dossier:
        description: "Dossier de destination sur MEGA"
        required: false
        default: "/Root/Videos"

jobs:
  transfer:
    runs-on: ubuntu-latest
    timeout-minutes: 350
    steps:
      - name: Installer les outils
        run: sudo apt-get update && sudo apt-get install -y aria2 megatools

      - name: Lister les fichiers du torrent
        if: ${{ inputs.lister }}
        env:
          URL: ${{ inputs.url }}
        run: |
          mkdir -p meta
          if [[ "$URL" == magnet:* ]]; then
            aria2c --bt-metadata-only=true --bt-save-metadata=true -d meta "$URL"
          else
            aria2c --follow-torrent=false -d meta "$URL"
          fi
          echo "=========== LISTE DES FICHIERS (numéro | nom | taille) ==========="
          aria2c -S meta/*.torrent

      - name: Télécharger
        if: ${{ !inputs.lister }}
        env:
          URL: ${{ inputs.url }}
          FICHIERS: ${{ inputs.fichiers }}
        run: |
          mkdir -p dl
          ARGS=""
          if [ -n "$FICHIERS" ]; then
            ARGS="--select-file=$FICHIERS"
          fi
          aria2c $ARGS --seed-time=0 -x 16 -s 16 --summary-interval=30 -d dl "$URL"

      - name: Envoyer sur MEGA
        if: ${{ !inputs.lister }}
        env:
          MEGA_EMAIL: ${{ secrets.MEGA_EMAIL }}
          MEGA_PASSWORD: ${{ secrets.MEGA_PASSWORD }}
          DEST: ${{ inputs.dossier }}
        run: |
          megatools mkdir -u "$MEGA_EMAIL" -p "$MEGA_PASSWORD" "$DEST" || true
          megatools copy --no-progress -u "$MEGA_EMAIL" -p "$MEGA_PASSWORD" \
            --local dl --remote "$DEST"
